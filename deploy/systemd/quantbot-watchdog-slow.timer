[Unit]
Description=Run quant-bot watchdog (slow profile) hourly
# Phase 1 has no jobs registered on the slow profile yet (checks.yaml's
# managed cron jobs are all cheap enough to run on the fast profile) --
# this unit exists so the slow lane doesn't need a new systemd rollout
# when heavier checks (test-suite drift, batch_verify, etc.) land later.

[Timer]
# :03 past the hour, not :00 -- the fast timer's *:0/5 schedule also fires
# at :00 every hour, so "hourly" (:00) guaranteed a singleton-lock
# collision on every single run. The collision itself was handled
# correctly (no overlapping runs), but it's needless lock contention this
# avoids entirely rather than just tolerating.
OnCalendar=*-*-* *:03:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
