venv/
.venv/
.env
.claude/
__pycache__/
*.pyc
.DS_Store

# Telethon session files — contain auth credentials, never commit
*.session
memecoin/data/tg_session
memecoin/data/tg_session.session

# Large raw data file (re-fetchable)
data/historical_raw.json

# watchdog runtime state -- SQLite DB + lock file, never committed.
# NOT a blanket ignore of logs/watchdog/ -- that also caught
# logs/watchdog/audits/ and layer2_heartbeat.json, which Layer 2's
# GitHub Actions workflow explicitly needs to commit (found live: the
# very first real workflow run's "Commit audit artifacts" step failed
# outright with "paths are ignored by one of your .gitignore files").
logs/watchdog/state.db
logs/watchdog/state.db-*
logs/watchdog/runner.lock

# Keep logs in repo so GitHub Actions can commit daily results
!logs/market_journal.csv
!logs/live_scan_results.csv
!logs/memecoin_live_journal.csv
!logs/memecoin_social_journal.csv
!logs/memecoin_journal.csv
!logs/exit_route_attempts.csv
!logs/gate_blocks.csv
!logs/trade_telemetry_summary.csv
